<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="500.0" spacing="12.0" styleClass="root-pane" stylesheets="@todo-style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.todoprojekt.ToDoController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <Label styleClass="title" text="Teendők" />

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="taskInputField" onAction="#onAddButtonClick" promptText="Írd ide a feladat nevét..." HBox.hgrow="ALWAYS" />
                <Button onAction="#onAddButtonClick" styleClass="add-button" text="Hozzáadás" />
            </children>
        </HBox>

        <TableView fx:id="tableView" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="doneColumn" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" sortable="false" text="Kész" />
                <TableColumn fx:id="taskColumn" sortable="false" text="Feladat" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label fx:id="counterLabel" styleClass="counter" />

        <HBox spacing="10.0">
            <children>
                <Button maxWidth="1.7976931348623157E308" onAction="#onDeleteButtonClick" styleClass="secondary-button" text="Törlés" HBox.hgrow="ALWAYS" />
                <Button maxWidth="1.7976931348623157E308" onAction="#onClearDoneButtonClick" styleClass="secondary-button" text="Készek törlése" HBox.hgrow="ALWAYS" />
                <Button maxWidth="1.7976931348623157E308" onAction="#onClearAllButtonClick" styleClass="secondary-button" text="Összes törlése" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>
